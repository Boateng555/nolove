{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "chmod +x build.sh && ./build.sh",
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{staticfiles/**,proposal/templates/**,static/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
